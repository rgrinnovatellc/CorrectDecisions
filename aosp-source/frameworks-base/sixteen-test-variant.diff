+    @Test
+    public void testPendingReasonStats_rescheduleWithOpenIntervalCharacterization() {
+        // Harness-constructible is NOT the same as production-reachable. This scenario
+        // deliberately leaves one open timestamp in the open-timestamp map at the generation
+        // boundary and characterizes what the pinned code computes GIVEN that state. It settles
+        // nothing about whether a real generation boundary can be reached with that map
+        // non-empty; spec task 6.2 owns the production-reachability question, and this scenario
+        // is evidence about the arithmetic only, never about reachability.
+        final TestClock testClock = new TestClock();
+        JobSchedulerService.sElapsedRealtimeClock = testClock;
+        final JobStatus job = createRestrictedAppStandbyJob(testClock);
+
+        // Close one interval so the accumulator holds 10 ms.
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), false);
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), true);
+
+        // Then open a second interval at t=30 and never close it.
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), false);
+
+        testClock.advanceTime(10);
+        final JobStatus periodic = nextPeriodicGeneration(job, testClock);
+        testClock.advanceTime(10);
+        final long reported = getPendingReasonDuration(periodic,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+
+        // 10 ms of carried total plus 50 - 30 = 20 ms measured from a timestamp the previous
+        // generation recorded, against an origin the boundary reset to 40.
+        assertEquals(30, reported);
+        assertTrue(reported > testClock.millis() - periodic.enqueueTime);
+    }
