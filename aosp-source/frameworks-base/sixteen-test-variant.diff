+    /**
+     * The next generation of a periodic job, built the way production builds it: the periodic
+     * reschedule path passes nine arguments to the reschedule constructor, which is the
+     * constructor that clones both pending-reason accumulators, and startTrackingJobLocked then
+     * resets the per-generation origin. Both steps are production code; no map is copied here.
+     */
+    private static JobStatus nextPeriodicGeneration(JobStatus job, TestClock testClock) {
+        final JobStatus periodic = new JobStatus(job,
+                testClock.millis() + 30_000, testClock.millis() + 60_000,
+                0 /* numFailures */, 0 /* numSystemStops */,
+                0 /* numAbandonedFailures */,
+                JobSchedulerService.sSystemClock.millis() /* lastSuccessfulRunTime */,
+                job.getLastFailedRunTime(),
+                0 /* Reset cumulativeExecutionTime because of successful execution */);
+        periodic.enqueueTime = testClock.millis();
+        return periodic;
+    }
