+    /**
+     * A job that *requests* battery-not-low gets its own public reason for that constraint, while
+     * charging and idle still collapse onto APP_STANDBY. Truthfully the requested constraint blocks
+     * the job for longer (25) than App Standby does (15 union, 20 additive), but the shared key
+     * takes the enqueue fallback and reports 40 -- so the reported ranking inverts the true one.
+     * This is the decision the documentation asks developers to make: sort the durations and act on
+     * whichever is largest.
+     */
+    @EnableFlags({
+            android.app.job.Flags.FLAG_ENHANCED_PENDING_AND_STOP_REASONS_API
+    })
+    @Test
+    public void testPendingReasonStats_rankingReversalCharacterization() {
+        final TestClock testClock = new TestClock();
+        JobSchedulerService.sElapsedRealtimeClock = testClock;
+        final JobStatus job = createRestrictedJobRequiringBatteryNotLow(testClock);
+
+        // t=5: the requested constraint goes unsatisfied and opens its own dedicated entry.
+        testClock.advanceTime(5);
+        job.setBatteryNotLowConstraintSatisfied(testClock.millis(), false);
+
+        // t=20 and t=25: two conditions that share APP_STANDBY open, the second overwriting the
+        // first's timestamp because one entry serves both.
+        testClock.advanceTime(15);
+        job.setChargingConstraintSatisfied(testClock.millis(), false);
+        testClock.advanceTime(5);
+        job.setIdleConstraintSatisfied(testClock.millis(), false);
+
+        // t=30: charging closes and consumes the shared entry; battery-not-low closes its own.
+        testClock.advanceTime(5);
+        job.setChargingConstraintSatisfied(testClock.millis(), true);
+        job.setBatteryNotLowConstraintSatisfied(testClock.millis(), true);
+
+        // t=35: idle closes, finds nothing stored, and charges the job's whole life again.
+        testClock.advanceTime(5);
+        job.setIdleConstraintSatisfied(testClock.millis(), true);
+
+        final long standby = getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+        final long requested = getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_CONSTRAINT_BATTERY_NOT_LOW);
+
+        recordPendingReasonObservation("ranking_reversal_standby", standby, 15, 35);
+        recordPendingReasonObservation("ranking_reversal_requested", requested, 25, 35);
+
+        // The requested constraint is accounted correctly against its own key.
+        assertEquals(25, requested);
+        // The collapsed key reports more than the job's whole life.
+        assertEquals(40, standby);
+        assertTrue(standby > testClock.millis() - job.enqueueTime);
+        // The ranking the documentation asks developers to read is inverted: truthfully the
+        // requested constraint dominates, but the reported totals say otherwise.
+        assertTrue(15 < 25);
+        assertTrue(standby > requested);
+    }
+
+    /**
+     * Same restricted-bucket entry as the shared factory, except the job explicitly requests
+     * battery-not-low, which routes that constraint to its own public reason instead of
+     * APP_STANDBY while charging and idle still collapse.
+     */
+    private static JobStatus createRestrictedJobRequiringBatteryNotLow(TestClock testClock) {
+        final JobStatus job = createJobStatus(
+                new JobInfo.Builder(1234, TEST_JOB_COMPONENT)
+                        .setRequiresBatteryNotLow(true).build());
+        job.enqueueTime = testClock.millis();
+
+        job.setStandbyBucket(RESTRICTED_INDEX, REASON_MAIN_FORCED_BY_SYSTEM);
+        job.setChargingConstraintSatisfied(testClock.millis(), true);
+        job.setBatteryNotLowConstraintSatisfied(testClock.millis(), true);
+        job.setIdleConstraintSatisfied(testClock.millis(), true);
+        assertTrue(job.areDynamicConstraintsSatisfied());
+        return job;
+    }
