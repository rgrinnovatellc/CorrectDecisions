+    private static JobStatus createRestrictedAppStandbyJob(TestClock testClock) {
+        // No explicit constraints: explicit charging and battery-not-low constraints project to
+        // distinct public keys instead of APP_STANDBY.
+        final JobStatus job = createJobStatus(
+                new JobInfo.Builder(1234, TEST_JOB_COMPONENT).build());
+        job.enqueueTime = testClock.millis();
+
+        // Production QuotaController adds RESTRICTED membership before controllers publish their
+        // current truth snapshots. At the same enqueue clock, add membership first and then
+        // establish charging, battery-not-low, and idle as satisfied. This creates a zero-time
+        // shared-key baseline while preserving the production ordering.
+        job.setStandbyBucket(RESTRICTED_INDEX, REASON_MAIN_FORCED_BY_SYSTEM);
+        assertFalse(job.areDynamicConstraintsSatisfied());
+        job.setChargingConstraintSatisfied(testClock.millis(), true);
+        job.setBatteryNotLowConstraintSatisfied(testClock.millis(), true);
+        job.setIdleConstraintSatisfied(testClock.millis(), true);
+        assertTrue(job.areDynamicConstraintsSatisfied());
+        return job;
+    }
+
+    private static long getPendingReasonDuration(JobStatus job,
+            @JobScheduler.PendingJobReason int reason) {
+        final ParcelDuration duration = job.getPendingJobReasonStats().get(
+                String.valueOf(reason));
+        assertNotNull(duration);
+        return duration.getDuration().toMillis();
