+    /**
+     * Production-reachability of a non-empty open-timestamp map at a generation boundary
+     * (spec task 6.2). Dropping out of the restricted bucket removes the dynamic membership
+     * through the production path while a mapped constraint is still unsatisfied, so nothing ever
+     * closes the open entry -- and the accumulator write set contains no other site that could.
+     * The job is then ready, runs, and rolls over.
+     *
+     * The carried timestamp is observed indirectly, because the map is private: satisfying the
+     * shared constraint in the NEW generation computes 50 - 10 = 40 if the previous generation's
+     * timestamp survived the copy, and 50 - 30 = 20 if it did not. Observing 40 is what makes this
+     * a demonstration rather than a reading.
+     */
+    @EnableFlags({
+            android.app.job.Flags.FLAG_ENHANCED_PENDING_AND_STOP_REASONS_API
+    })
+    @Test
+    public void testPendingReasonStats_openIntervalReachesGenerationBoundaryCharacterization() {
+        final TestClock testClock = new TestClock();
+        JobSchedulerService.sElapsedRealtimeClock = testClock;
+        final JobStatus job = createRestrictedAppStandbyJob(testClock);
+
+        // t=10: a mapped constraint goes unsatisfied and opens the shared entry.
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), false);
+
+        // t=20: the app is used again and leaves the restricted bucket. Production removes the
+        // dynamic membership; the open entry is never closed because nothing satisfies it.
+        testClock.advanceTime(10);
+        job.setStandbyBucket(ACTIVE_INDEX, REASON_MAIN_USAGE);
+
+        // t=30: the periodic job rolls over through the production reschedule constructor.
+        testClock.advanceTime(10);
+        final JobStatus periodic = nextPeriodicGeneration(job, testClock);
+        assertEquals(testClock.millis(), periodic.enqueueTime);
+
+        // t=50: satisfy the shared constraint in the new generation. 50 - 10 = 40 means the old
+        // generation's timestamp crossed the boundary and was consumed here; 50 - 30 = 20 would
+        // mean it did not.
+        testClock.advanceTime(20);
+        periodic.setChargingConstraintSatisfied(testClock.millis(), true);
+        final long reported = getPendingReasonDuration(periodic,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+
+        assertEquals(40, reported);
+        assertTrue(reported > testClock.millis() - periodic.enqueueTime);
+    }
