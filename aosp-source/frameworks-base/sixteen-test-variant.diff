+    @Test
+    public void testPendingReasonStats_samePublicReasonChargingFirstCloseCharacterization() {
+        final TestClock testClock = new TestClock();
+        JobSchedulerService.sElapsedRealtimeClock = testClock;
+        final JobStatus job = createRestrictedAppStandbyJob(testClock);
+        final long[] observed = new long[4];
+
+        assertEquals(0, getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY));
+
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), false);
+        observed[0] = getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+
+        testClock.advanceTime(10);
+        job.setBatteryNotLowConstraintSatisfied(testClock.millis(), false);
+        observed[1] = getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), true);
+        observed[2] = getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+
+        testClock.advanceTime(10);
+        job.setBatteryNotLowConstraintSatisfied(testClock.millis(), true);
+        observed[3] = getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+
+        recordPendingReasonObservation(
+                "overlap_charging_first_close", observed[3], 30, 40);
+        // Characterize the implementation without making the derived union oracle the JUnit
+        // pass/fail condition. The host-side verifier compares this emitted value to the oracle.
+        assertArrayEquals(new long[] { 0, 0, 10, 50 }, observed);
+        assertTrue(observed[3] > testClock.millis() - job.enqueueTime);
+    }
