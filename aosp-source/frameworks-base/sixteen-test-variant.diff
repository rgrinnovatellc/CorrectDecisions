+        JobSchedulerService.sElapsedRealtimeClock = testClock;
+        final JobStatus job = createJobStatus(
+                new JobInfo.Builder(1234, TEST_JOB_COMPONENT).build());
+        job.enqueueTime = testClock.millis();
+
+        testClock.advanceTime(40);
+        // Entry state: no restrictive controller has published to this job yet, so all three
+        // restricted-set bits are clear going in. Which publish below flips a bit is what decides
+        // the multiplier, because setConstraintSatisfied returns early on an unchanged bit and
+        // never reaches the accumulator.
+        assertFalse(job.isConstraintSatisfied(CONSTRAINT_CHARGING));
+        assertFalse(job.isConstraintSatisfied(CONSTRAINT_BATTERY_NOT_LOW));
+        assertFalse(job.isConstraintSatisfied(CONSTRAINT_IDLE));
+        job.setStandbyBucket(RESTRICTED_INDEX, REASON_MAIN_FORCED_BY_SYSTEM);
+        assertFalse(job.areDynamicConstraintsSatisfied());
+
+        // Unplugged, healthy battery, device not idle: idle and charging publish false, which
+        // changes nothing, and only battery-not-low flips. Publication order matches the reverse
+        // controller iteration: idle first, then charging, then battery-not-low.
+        assertFalse(job.setIdleConstraintSatisfied(testClock.millis(), false));
+        assertFalse(job.setChargingConstraintSatisfied(testClock.millis(), false));
+        assertTrue(job.setBatteryNotLowConstraintSatisfied(testClock.millis(), true));
+
+        final long credited = getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+        assertEquals(40, credited);
+        assertEquals(testClock.millis() - job.enqueueTime, credited);
+    }
