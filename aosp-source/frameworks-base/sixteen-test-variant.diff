+    public void testPendingReasonStats_periodicRescheduleRolloverCharacterization() {
+        final TestClock testClock = new TestClock();
+        JobSchedulerService.sElapsedRealtimeClock = testClock;
+        final JobStatus job = createRestrictedAppStandbyJob(testClock);
+
+        // One ordinary closed interval on the shared public key: charging goes unsatisfied at
+        // t=10 and satisfied again at t=20, so the accumulator holds exactly 10 ms.
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), false);
+        testClock.advanceTime(10);
+        job.setChargingConstraintSatisfied(testClock.millis(), true);
+        assertEquals(10, getPendingReasonDuration(job,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY));
+
+        // The generation boundary a successful periodic execution goes through. The next
+        // generation is built by the production nine-argument reschedule constructor, so the
+        // clone inside that constructor is the code under test; nothing here copies a map.
+        testClock.advanceTime(10);
+        final JobStatus periodic = nextPeriodicGeneration(job, testClock);
+
+        // Characterization of the pinned bytes, not a wish: the next generation has a fresh
+        // origin and no satisfied dynamic bit, and still reports the carried total.
+        assertEquals(testClock.millis(), periodic.enqueueTime);
+        assertFalse(periodic.areDynamicConstraintsSatisfied());
+        assertEquals(10, getPendingReasonDuration(periodic,
+                JobScheduler.PENDING_JOB_REASON_APP_STANDBY));
+    }
