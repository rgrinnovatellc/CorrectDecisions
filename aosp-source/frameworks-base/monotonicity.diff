+    private static JobStatus createRestrictedAppStandbyJobForMonotonicity(TestClock testClock) {
+        final JobStatus job =
+                createJobStatus(new JobInfo.Builder(1234, TEST_JOB_COMPONENT).build());
+        job.enqueueTime = testClock.millis();
+        job.setStandbyBucket(RESTRICTED_INDEX, REASON_MAIN_FORCED_BY_SYSTEM);
+        assertFalse(job.areDynamicConstraintsSatisfied());
+
+        // These real false-to-true transitions create a present, zero-valued APP_STANDBY total
+        // through the production updater at the enqueue clock.
+        assertTrue(job.setChargingConstraintSatisfied(testClock.millis(), true));
+        assertTrue(job.setBatteryNotLowConstraintSatisfied(testClock.millis(), true));
+        assertTrue(job.setIdleConstraintSatisfied(testClock.millis(), true));
+        assertTrue(job.areDynamicConstraintsSatisfied());
+        return job;
+    }
+
+    private static void assertMonotonicityTracePremises(
+            JobStatus job,
+            int expectedJobId,
+            long expectedEnqueueTime,
+            boolean chargingSatisfied,
+            boolean batteryNotLowSatisfied,
+            boolean idleSatisfied) {
+        assertEquals(expectedJobId, job.getJobId());
+        assertEquals(expectedEnqueueTime, job.enqueueTime);
+        assertEquals(RESTRICTED_INDEX, job.getStandbyBucket());
+        assertEquals(REASON_MAIN_FORCED_BY_SYSTEM, job.getStandbyBucketReason());
+
+        // None of the focal constraints was requested by the app; their unchanged membership is
+        // therefore the dynamic membership supplied by the Restricted standby bucket.
+        assertFalse(job.getJob().isRequireCharging());
+        assertFalse(job.getJob().isRequireBatteryNotLow());
+        assertFalse(job.getJob().isRequireDeviceIdle());
+        assertTrue(job.hasChargingConstraint());
+        assertTrue(job.hasBatteryNotLowConstraint());
+        assertTrue(job.hasIdleConstraint());
+        assertFocalConstraintStates(job, chargingSatisfied, batteryNotLowSatisfied, idleSatisfied);
+        assertFalse(job.areDynamicConstraintsSatisfied());
+        // This component fixture is not registered in JobStore; this proves ineligibility only.
+        assertFalse(job.isReady());
+
+        assertCurrentAppStandbyReason(job);
+    }
+
+    private static void assertCurrentAppStandbyReason(JobStatus job) {
+        final long appStandbyOccurrences =
+                Arrays.stream(job.getPendingJobReasons(null))
+                        .filter(reason -> reason == JobScheduler.PENDING_JOB_REASON_APP_STANDBY)
+                        .count();
+        assertEquals(1, appStandbyOccurrences);
+    }
+
+    private static void assertFocalConstraintStates(
+            JobStatus job,
+            boolean chargingSatisfied,
+            boolean batteryNotLowSatisfied,
+            boolean idleSatisfied) {
+        assertEquals(chargingSatisfied, job.isConstraintSatisfied(CONSTRAINT_CHARGING));
+        assertEquals(batteryNotLowSatisfied, job.isConstraintSatisfied(CONSTRAINT_BATTERY_NOT_LOW));
+        assertEquals(idleSatisfied, job.isConstraintSatisfied(CONSTRAINT_IDLE));
+    }
+
+    private static long getPendingReasonDurationForMonotonicity(
+            JobStatus job, @JobScheduler.PendingJobReason int reason) {
+        final ParcelDuration duration = job.getPendingJobReasonStats().get(String.valueOf(reason));
+        assertNotNull(duration);
+        return duration.getDuration().toMillis();
+    }
+
