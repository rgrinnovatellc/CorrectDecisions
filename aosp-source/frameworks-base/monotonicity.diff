+    // The shared-reason mapping and duration updater are independent of the enhanced-reasons flag.
+    @Test
+    public void
+            testPendingReasonStats_samePublicReasonDurationDecreasesWithoutResetCharacterization() {
+        final TestClock testClock = new TestClock();
+        JobSchedulerService.sElapsedRealtimeClock = testClock;
+        final JobStatus queriedJob = createRestrictedAppStandbyJobForMonotonicity(testClock);
+        final JobStatus noT19StatsQueryControl =
+                createRestrictedAppStandbyJobForMonotonicity(testClock);
+        final int jobId = queriedJob.getJobId();
+        final long enqueueTime = queriedJob.enqueueTime;
+        final int controlJobId = noT19StatsQueryControl.getJobId();
+        final long controlEnqueueTime = noT19StatsQueryControl.enqueueTime;
+        final String appStandbyKey = String.valueOf(JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+
+        // The query path treats an absent total differently from a present zero total, so verify
+        // the reachable initialization state explicitly rather than defaulting absence to zero.
+        final Map<String, ParcelDuration> initialStats = queriedJob.getPendingJobReasonStats();
+        assertTrue(initialStats.containsKey(appStandbyKey));
+        assertEquals(0, initialStats.get(appStandbyKey).getDuration().toMillis());
+        final Map<String, ParcelDuration> controlInitialStats =
+                noT19StatsQueryControl.getPendingJobReasonStats();
+        assertTrue(controlInitialStats.containsKey(appStandbyKey));
+        assertEquals(0, controlInitialStats.get(appStandbyKey).getDuration().toMillis());
+
+        // t=10: charging becomes unsatisfied and opens the shared APP_STANDBY boundary.
+        testClock.advanceTime(10);
+        assertTrue(queriedJob.setChargingConstraintSatisfied(testClock.millis(), false));
+        assertTrue(
+                noT19StatsQueryControl.setChargingConstraintSatisfied(testClock.millis(), false));
+
+        // t=19: the same ineligible JobStatus still has stable Restricted membership and a current
+        // APP_STANDBY reason. Its lifetime total is observed as nine time units.
+        testClock.advanceTime(9);
+        assertMonotonicityTracePremises(queriedJob, jobId, enqueueTime, false, true, true);
+        assertMonotonicityTracePremises(
+                noT19StatsQueryControl, controlJobId, controlEnqueueTime, false, true, true);
+        final long earlier =
+                getPendingReasonDurationForMonotonicity(
+                        queriedJob, JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+        assertEquals(9, earlier);
+
+        // t=20, before the overwrite: the t=19 query has not changed the saved accounting state.
+        testClock.advanceTime(1);
+        final long queriedBeforeOverwrite =
+                getPendingReasonDurationForMonotonicity(
+                        queriedJob, JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+        final long controlBeforeOverwrite =
+                getPendingReasonDurationForMonotonicity(
+                        noT19StatsQueryControl, JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+        assertEquals(10, queriedBeforeOverwrite);
+        assertEquals(10, controlBeforeOverwrite);
+        assertEquals(controlBeforeOverwrite, queriedBeforeOverwrite);
+
+        // t=20: battery-not-low becomes unsatisfied and overwrites charging's shared boundary.
+        assertTrue(queriedJob.setBatteryNotLowConstraintSatisfied(testClock.millis(), false));
+        assertTrue(
+                noT19StatsQueryControl.setBatteryNotLowConstraintSatisfied(
+                        testClock.millis(), false));
+
+        // t=21: APP_STANDBY remains current, but the reported lifetime total drops from 9 to 1.
+        testClock.advanceTime(1);
+        assertMonotonicityTracePremises(queriedJob, jobId, enqueueTime, false, false, true);
+        assertMonotonicityTracePremises(
+                noT19StatsQueryControl, controlJobId, controlEnqueueTime, false, false, true);
+        final long later =
+                getPendingReasonDurationForMonotonicity(
+                        queriedJob, JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+        final long noT19StatsQueryLater =
+                getPendingReasonDurationForMonotonicity(
+                        noT19StatsQueryControl, JobScheduler.PENDING_JOB_REASON_APP_STANDBY);
+        assertEquals(1, later);
+        assertEquals(1, noT19StatsQueryLater);
+        // Both jobs received identical t=0/t=20 stats reads and transitions; only queriedJob
+        // received the duration-stats query at t=19.
+        assertEquals(noT19StatsQueryLater, later);
+        assertTrue("a cumulative lifetime total decreased without a reset", later < earlier);
+    }
 
